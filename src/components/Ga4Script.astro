---
import { SITE } from "../config/site";
import { buildAnalyticsBootstrap } from "../lib/analytics-bootstrap.js";

const measurementId = (import.meta.env.SITE_GA4_MEASUREMENT_ID ||
  import.meta.env.PUBLIC_GA4_MEASUREMENT_ID ||
  SITE.ga4MeasurementId ||
  "").trim();

const inline = measurementId ? buildAnalyticsBootstrap(measurementId) : "";
---
{measurementId ? (
  <script is:inline type="text/javascript" set:html={inline}></script>
) : null}
